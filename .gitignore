# Raw Jira API responses (working files, never commit)
.tmp-jira/

# Run folders: only the consolidated folder of each epic is committed ({VERSION}_{EPIC}_{DDMMYYYY-HHMM})
.claude/Data/output/reports/runs/*
!.claude/Data/output/reports/runs/GEO-R*_*/

# Screenshot buffers at the reports root (moved into runs/ when a report is built)
.claude/Data/output/reports/screenshots-*/

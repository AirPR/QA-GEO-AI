# Données sensibles et credentials
.env
.env.local
.env.*.local
*.token

# Permissions locales Claude Code (peut contenir des secrets, jamais à committer)
.claude/settings.local.json

# Session Auth0 (cookies + localStorage) — données sensibles, jamais à committer
.claude/Data/processed/auth/

# Artefacts transient Playwright (error-context.md, traces, vidéos) — régénérés à chaque run
.claude/Data/raw/playwright/artifacts/

# Logs et snapshots MCP Playwright — générés automatiquement à chaque session, aucune valeur livrable
.playwright-mcp/

# Lock file local du scheduler (état runtime)
.claude/scheduled_tasks.lock

# Raw Playwright JSON quand le RUN_ID n'est pas défini (artefact debug)
.claude/Data/raw/playwright/test-results-unknown-raw.json

# Node.js
node_modules/
npm-debug.log*

# OS
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/
WBT/
web/
web-En.rar

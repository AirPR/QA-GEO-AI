      {
        "id": "GEO-107",
        "title": "[Story 4.3] Overview — 5 KPI Cards",
        "storyId": "Story 4.3",
        "status": "Done",
        "jiraUrl": "https://onclusive.atlassian.net/browse/GEO-107",
        "kpis": [
          {
            "name": "Share of Voice",
            "unit": "%",
            "formula": "Visibility% × (2 / (AvgPosition + 1))",
            "thresholds": {
              "good": ">50%",
              "fair": ">25%",
              "poor": "≤25%"
            }
          },
          {
            "name": "Visibility",
            "unit": "%",
            "formula": "mentionCount / totalLLMResponseCount × 100"
          },
          {
            "name": "Avg Position",
            "unit": "rank",
            "formula": "ceil(mean(target_rank)), unranked = 11"
          },
          {
            "name": "Win Rate",
            "unit": "%",
            "formula": "winsCount / totalCompetitiveResponses × 100"
          },
          {
            "name": "Sentiment",
            "unit": "score",
            "formula": "sum(score × freq) / sum(freq)",
            "range": "-100 to +100"
          }
        ]
      },

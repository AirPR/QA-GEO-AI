# GEO QA — Environment configuration template
# Copy this file to .env and fill in your credentials.
# .env is gitignored — never commit real credentials.

# ── Credentials ───────────────────────────────────────────────────────────────
GEO_USER_EMAIL=your.email@example.com
GEO_USER_PASSWORD=yourpassword
# PQL / Lite account (upsell page)
GEO_USER_PQL_EMAIL=your.pql.test@example.com
GEO_USER_PQL_PASSWORD=yourpassword
# Role accounts for permission tests (main account = SUPER_ADMIN)
GEO_USER_EDITOR_EMAIL=your.editor@example.com
GEO_USER_EDITOR_PASSWORD=yourpassword
GEO_USER_READER_EMAIL=your.reader@example.com
GEO_USER_READER_PASSWORD=yourpassword

# ── URLs par environnement ────────────────────────────────────────────────────
BASE_URL_STAGING=https://staging-geo.onclusive.com/geo
BASE_URL_PROD=https://geo.onclusive.com/geo

# BASE_URL active — modifier selon l'env cible avant de lancer les tests
BASE_URL=https://staging-geo.onclusive.com/geo

# ── Dashboard / Category UUIDs par environnement ─────────────────────────────
# Staging — Toyota / Hybrid Cars
STAGING_DASHBOARD_UUID=439acd96-0b1b-4da4-9e07-612d38e9783e
STAGING_CATEGORY_UUID=21a79173-c455-4e49-bf69-307dc2dba7e4

# Prod — Toyota / Hybrid Cars
PROD_DASHBOARD_UUID=9864c210-948d-4813-aab8-6a007e9127c2
PROD_CATEGORY_UUID=

# ── Upsell/PQL test account ───────────────────────────────────────────────────
UPSELL_USER_EMAIL=your.upsell.test@example.com
UPSELL_USER_PASSWORD=yourpassword
UPSELL_URL=https://staging-geo.onclusive.com/geo/upsell

# ── Jira Configuration ────────────────────────────────────────────────────────
JIRA_URL=https://onclusive.atlassian.net
JIRA_EMAIL=your.email@example.com
# Token: Atlassian account → Profile → Account settings → Security → Create and manage API tokens
JIRA_TOKEN=your_jira_token
JIRA_PROJECT_KEY=GEO

# ── Quality Plus Configuration ────────────────────────────────────────────────
QP_URL=https://apps-qalityplus.soldevelo.com
# Token: Jira → QAlity Plus → QAlity Plus API Tokens → Create token
QP_TOKEN=your_QP_token
# Project ID of GEO in Quality Plus: 16421
QP_PROJECT_ID=
QP_IMPORT_ENDPOINT=/import-test-cases

# ── GitHub Configuration ──────────────────────────────────────────────────────
GITHUB_TOKEN=your_github_token

# ── Figma Configuration ───────────────────────────────────────────────────────
FIGMA_TOKEN=your_figma_token
